{
  "name": "quota-loom",
  "private": true,
  "version": "0.1.4",
  "description": "Local-first desktop usage analytics for Claude Code, Codex CLI, and ChatGPT Codex.",
  "license": "MIT",
  "author": "EricSmOOn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EricsmOOn/quota-loom.git"
  },
  "homepage": "https://github.com/EricsmOOn/quota-loom#readme",
  "bugs": {
    "url": "https://github.com/EricsmOOn/quota-loom/issues"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.18.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "check": "npm run format:check && npm run lint && npm run test && npm run build && npm run version:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:check": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.20",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "lucide-react": "^1.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
